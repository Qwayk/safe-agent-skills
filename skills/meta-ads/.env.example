# Meta Ads / Marketing API configuration
META_ADS_BASE_URL=https://graph.facebook.com
META_ADS_API_VERSION=v25.0

# Required for authenticated commands (do not commit real tokens):
META_ADS_ACCESS_TOKEN=

# Optional default ad account id (numeric id or act_<id>):
META_ADS_AD_ACCOUNT_ID=
# Example: act_1234567890

# Networking defaults:
META_ADS_TIMEOUT_S=30
META_ADS_MAX_RETRIES=5

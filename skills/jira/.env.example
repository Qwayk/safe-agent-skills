# Jira Cloud site URL for Basic auth, for example https://example.atlassian.net
# For OAuth 2.0, use https://api.atlassian.com/ex/jira/<cloud-id>
JIRA_BASE_URL=

# Default: Atlassian account email plus API token.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional alternative: OAuth 2.0 bearer token. When set, this takes priority.
JIRA_OAUTH_ACCESS_TOKEN=

JIRA_TIMEOUT_S=30

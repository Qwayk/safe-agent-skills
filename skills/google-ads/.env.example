# Google Ads API (OAuth2 + Google Cloud project access)
#
# Never commit real values. Keep secrets in a local `.env` (gitignored) and never paste them into chat.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Optional: if you use an MCC/manager account, set this to the manager customer id (digits only).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional: request timeout (seconds). Default: 30
GOOGLE_ADS_TIMEOUT_S=30

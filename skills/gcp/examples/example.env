# Copy to .env (do not commit .env)
# Google Cloud uses Application Default Credentials (ADC), so no fake base URL or token is needed.

# Optional: set a quota project if billing/quota should use a different project.
GCP_QUOTA_PROJECT=

# Optional guardrails. Leave blank if you do not want allowlists.
GCP_ALLOWED_PROJECTS=
GCP_ALLOWED_FOLDERS=
GCP_ALLOWED_ORGANIZATIONS=
GCP_ALLOWED_BILLING_ACCOUNTS=
GCP_ALLOWED_REGIONS=

# Optional timeout in seconds.
GCP_TIMEOUT_S=30

# Twilio credentials. Keep real values in .env and never commit them.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Warned fallback for local tests or unsupported API families only.
TWILIO_AUTH_TOKEN=

# Set both together when using regional routing.
TWILIO_REGION=
TWILIO_EDGE=

# Only for pinned OAuth operations that require bearer authentication.
TWILIO_OAUTH_ACCESS_TOKEN=

TWILIO_TIMEOUT_S=30
